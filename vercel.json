{
  "version": 2,
  "installCommand": "npm --prefix client install",
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/messages/:channelId",
      "destination": "/api/messages?channelId=:channelId"
    },
    {
      "source": "/api/dm/:userA/:userB",
      "destination": "/api/dm?userA=:userA&userB=:userB"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
